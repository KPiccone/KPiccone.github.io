:root {
    --phone-bg-main: #e0f7fa;
    --phone-accent: #ffffff;
    --dial-plate-bg: #81d4fa;
    --metal-details: #b0bec5;
    --text-primary: #0277bd;
    --display-bg: #ffffff;
    --display-num: #01579b;
    --confirm-bg: #4fc3f7;
    --shadow-soft: rgba(2, 119, 189, 0.2);
}
body {
    background-color: #f0faff;
    display: flex;
    justify-content: center;
    align-items: center;
    height: 100vh;
    margin: 0;
    font-family: 'Courier New', Courier, monospace;
    user-select: none;
}
#phone-base {
    width: 360px;
    height: 520px;
    background-color: var(--phone-bg-main);
    border-radius: 30px;
    box-shadow: 0 15px 40px var(--shadow-soft);
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 20px;
    border: 6px solid var(--phone-accent);
}
#receiver-cradle {
    width: 240px;
    height: 55px;
    background: var(--phone-accent);
    border: 3px solid var(--metal-details);
    border-radius: 25px;
    color: var(--text-primary);
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    font-weight: bold;
    font-size: 0.95em;
    margin-bottom: 30px;
    box-shadow: 0 4px 6px rgba(0,0,0,0.1);
    transition: all 0.3s ease;
}