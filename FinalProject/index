<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Rotary Volume Control</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div id="phone-base">
        <div id="receiver-cradle" class="on-hook">
            LIFT RECEIVER TO CONFIRM
        </div>

        <div id="dial-container">
            <div class="sign-label" id="plus-sign">+</div>
            <div class="sign-label" id="minus-sign">-</div>
            <div id="finger-stop"></div>

            <div id="rotary-plate"></div>
        </div>

        <div id="volume-display">
            <div id="volume-label">CURRENT VOLUME</div>
            <div id="current-total">0</div>
        </div>
    </div>

    <script src="script.js"></script>
</body>
</html>
