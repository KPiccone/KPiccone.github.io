const plate = document.getElementById('rotary-plate');
const totalDisplay = document.getElementById('current-total');
const cradle = document.getElementById('receiver-cradle');

let currentVolume = 0;
let isDragging = false;
let startAngle = 0;
let currentRotation = 0;
let activeNumber = 0;

for (let i = 1; i <= 10; i++) {
    const hole = document.createElement('div');
    hole.className = 'finger-hole';
    const val = (i === 10) ? 0 : i;
    hole.innerText = val;
    hole.dataset.value = i;

    const angle = (i * 25) + 45; 
    const radius = 105;
    const x = Math.cos(angle * Math.PI / 180) * radius + 118;
    const y = Math.sin(angle * Math.PI / 180) * radius + 118;
    hole.style.left = `${x}px`;
    hole.style.top = `${y}px`;

    hole.addEventListener('mousedown', (e) => startRotation(e, i));
    hole.addEventListener('touchstart', (e) => startRotation(e, i), { passive: false });
    plate.appendChild(hole);
}

function getAngle(e) {
    const rect = plate.getBoundingClientRect();
    const centerX = rect.left + rect.width / 2;
    const centerY = rect.top + rect.height / 2;
    const clientX = e.clientX || (e.touches && e.touches[0].clientX);
    const clientY = e.clientY || (e.touches && e.touches[0].clientY);
    return Math.atan2(clientY - centerY, clientX - centerX) * 180 / Math.PI;
}

function startRotation(e, val) {
    isDragging = true;
    activeNumber = val;
    startAngle = getAngle(e);
    plate.style.transition = 'none';

    document.addEventListener('mousemove', moveRotation);
    document.addEventListener('touchmove', moveRotation, { passive: false });
    document.addEventListener('mouseup', endRotation);
    document.addEventListener('touchend', endRotation);
}

function moveRotation(e) {
    if (!isDragging) return;
    if (e.cancelable) e.preventDefault();
    
    const currentAngle = getAngle(e);
    currentRotation = currentAngle - startAngle;
    plate.style.transform = `rotate(${currentRotation}deg)`;
}

function endRotation() {
    if (!isDragging) return;
    isDragging = false;

    const strength = Math.abs(currentRotation) / 100; 
    const change = Math.round(activeNumber * strength);

    if (currentRotation < 0) {
        currentVolume += change;
    } else {
        currentVolume -= change;
    }

    totalDisplay.innerText = currentVolume;

    plate.style.transition = 'transform 0.6s cubic-bezier(0.45, 0.05, 0.55, 0.95)';
    plate.style.transform = 'rotate(0deg)';
    
    document.removeEventListener('mousemove', moveRotation);
    document.removeEventListener('touchmove', moveRotation);
    document.removeEventListener('mouseup', endRotation);
    document.removeEventListener('touchend', endRotation);
    
    currentRotation = 0;
}

cradle.addEventListener('click', () => {
    cradle.classList.toggle('off-hook');
    if (cradle.classList.contains('off-hook')) {
        cradle.innerText = "VOLUME LOCKED";
        alert("Volume set to " + currentVolume);
    } else {
        cradle.innerText = "LIFT RECEIVER TO CONFIRM";
    }
});